pipeline {
    agent any

    environment {
        AWS_REGION      = 'eu-north-1'
        PROJECT_NAME    = 'myapp'
        APP_DIR         = '/opt/myapp'
        SSH_USER        = 'ubuntu'
        // Stored in Jenkins Credentials as "Secret text"
        AWS_ACCOUNT_ID  = credentials('aws-account-id')
        COMPOSE_FILE    = 'docker-compose.yml'
    }

    stages {

        // ──────────────────────────────────────────────────────
        stage('Git Clone') {
        // ──────────────────────────────────────────────────────
            steps {
                echo "📦 Checking out source code..."
                git branch: 'main',
                    url: 'https://github.com/ramsrikanthpabbineedi/Docker-Compose-.git',
                    credentialsId: 'github-pat'
            }
        }

        // ──────────────────────────────────────────────────────
        stage('Terraform Init') {
        // ──────────────────────────────────────────────────────
            steps {
                dir('terraform') {
                    withAWS(credentials: 'aws_id', region: "${AWS_REGION}") {
                        sh 'terraform init -input=false'
                    }
                }
            }
        }

        // ──────────────────────────────────────────────────────
        stage('Terraform Plan') {
        // ──────────────────────────────────────────────────────
            steps {
                dir('terraform') {
                    withAWS(credentials: 'aws_id', region: "${AWS_REGION}") {
                        sh 'terraform plan -out=tfplan -input=false'
                    }
                }
            }
        }

        // ──────────────────────────────────────────────────────
        stage('Terraform Apply') {
    steps {
        dir('terraform') {
            withAWS(credentials: 'aws_id', region: "${AWS_REGION}") {
                sh 'terraform apply -auto-approve -input=false tfplan'

                script {
                    env.EC2_PUBLIC_IP   = sh(
                        script: 'terraform output -raw public_ip',
                        returnStdout: true
                    ).trim()
                    env.EC2_INSTANCE_ID = sh(
                        script: 'terraform output -raw instance_id',
                        returnStdout: true
                    ).trim()
                    // ✅ Add this line
                    env.SNS_TOPIC_ARN   = sh(
                        script: 'terraform output -raw sns_topic_arn',
                        returnStdout: true
                    ).trim()
                }
            }
        }
        echo "✅ EC2 IP: ${env.EC2_PUBLIC_IP} | Instance: ${env.EC2_INSTANCE_ID}"
        echo "✅ SNS ARN: ${env.SNS_TOPIC_ARN}"
    }
}
      

        // ──────────────────────────────────────────────────────
        stage('Wait — EC2 Status Checks') {
        // ──────────────────────────────────────────────────────
        // Waits until AWS reports 2/2 status checks passed.
        // This means the OS kernel is up — but SSH may still be starting.
            steps {
                withAWS(credentials: 'aws_id', region: "${AWS_REGION}") {
                    sh """
                        echo "⏳ Waiting for EC2 status checks (2/2)..."
                        aws ec2 wait instance-status-ok \
                            --region ${AWS_REGION} \
                            --instance-ids ${env.EC2_INSTANCE_ID}
                        echo "✅ Status checks passed"
                    """
                }
            }
        }

        // ──────────────────────────────────────────────────────
        stage('Wait — SSH Accessible') {
        // ──────────────────────────────────────────────────────
        // Polls TCP port 22 until it accepts connections.
        // Separate from status checks — sshd can start a few seconds later.
            steps {
                sshagent(credentials: ['app-server-ssh']) {
                    sh """
                        echo "⏳ Waiting for SSH on ${env.EC2_PUBLIC_IP}..."
                        for i in \$(seq 1 15); do
                            if ssh -o StrictHostKeyChecking=no \
                                   -o ConnectTimeout=5 \
                                   -o BatchMode=yes \
                                   ${SSH_USER}@${env.EC2_PUBLIC_IP} 'echo ready' 2>/dev/null; then
                                echo "✅ SSH is up"
                                exit 0
                            fi
                            echo "  Attempt \$i/15 — sleeping 10s..."
                            sleep 10
                        done
                        echo "❌ SSH did not become available in time"
                        exit 1
                    """
                }
            }
        }
        stage('Ansible Ping Test') {
    steps {
        echo "📡 Testing Ansible connectivity to EC2..."
        sshagent(credentials: ['app-server-ssh']) {
            sh """
                # Get the key file from sshagent — no path issues
                SSH_KEY=\$(ssh-agent -s | grep SSH_AUTH_SOCK | cut -d= -f2 | cut -d';' -f1)

                # Write key directly from Jenkins credentials to a safe path
                mkdir -p /tmp/ansible
                cat \$SSH_AUTH_SOCK > /tmp/ansible/key 2>/dev/null || true

                # Better approach — write inventory pointing to sshagent socket
                cat > inventory.ini << EOF
[appservers]
${env.EC2_PUBLIC_IP} ansible_user=ubuntu

[appservers:vars]
ansible_ssh_common_args='-o StrictHostKeyChecking=no -o ConnectTimeout=10'
EOF

                echo "=== Inventory ==="
                cat inventory.ini

                # Test ping using sshagent (key is loaded automatically)
                ansible -i inventory.ini appservers -m ping
            """
        }
    }
}
stage('Ansible Configure Tools') {
    steps {
        echo "⚙️ Running Ansible Playbook..."
        sh '''
            cat > inventory.ini << 'EOF'
[web]
localhost ansible_connection=local
EOF

            # Fix 1: correct playbook filename
            # Fix 2: remove ansible_become_password= (empty password breaks sudo)
            ansible-playbook -i inventory.ini ansible/install_k8s_tools.yml\
                --become \
                -v
        '''
    }
}
        // ──────────────────────────────────────────────────────
stage('Build Images') {
    steps {
        withAWS(credentials: 'aws_id', region: "${AWS_REGION}") {
            sh '''
                cat > app/.env << EOF
PORT=5000
MONGO_URI=mongodb://mongo:27017/myfoodmylife
AWS_REGION=${AWS_REGION}
AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
AWS_SNS_TOPIC_ARN=${SNS_TOPIC_ARN}
EOF
                echo "✅ .env file created"
                sed -i '/^version:/d' app/docker-compose.yml

                # Build with DockerHub-prefixed names directly
                docker build -t ramsrikanthp/myfoodmylife-backend:latest  app/backend
                docker build -t ramsrikanthp/myfoodmylife-frontend:latest app/frontend
            '''
        }
    }
}
        // ──────────────────────────────────────────────────────
      stage('Push to Registry') {
    steps {
        withCredentials([usernamePassword(
            credentialsId: 'dockerhub-creds',
            usernameVariable: 'DOCKER_USER',
            passwordVariable: 'DOCKER_PASS')]) {
            sh '''
                echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                docker push ramsrikanthp/myfoodmylife-backend:latest
                docker push ramsrikanthp/myfoodmylife-frontend:latest
            '''
        }
    }
}
stage('Setup EC2 — Install Docker') {
    steps {
        sshagent(credentials: ['app-server-ssh']) {
            sh '''
                EC2_IP="''' + env.EC2_PUBLIC_IP + '''"
                echo "🐳 Installing Docker on $EC2_IP..."

                ssh -o StrictHostKeyChecking=no ubuntu@$EC2_IP \
                    "bash -s" << 'REMOTE'
                        set -euo pipefail

                        # Skip if already installed
                        if command -v docker &>/dev/null; then
                            echo "✅ Docker already installed: $(docker --version)"
                            exit 0
                        fi

                        echo "📦 Installing Docker..."
                        curl -fsSL https://get.docker.com | sudo sh

                        sudo usermod -aG docker ubuntu

                        sudo apt-get install -y docker-compose-plugin

                        sudo systemctl enable docker
                        sudo systemctl start docker

                        echo "✅ Docker installed: $(sudo docker --version)"
REMOTE
                echo "✅ EC2 Docker setup complete"
            '''
        }
    }
}

stage('Deploy Application') {
    steps {
        withCredentials([usernamePassword(
            credentialsId: 'dockerhub-creds',
            usernameVariable: 'DOCKER_USER',
            passwordVariable: 'DOCKER_PASS')]) {
            sshagent(credentials: ['app-server-ssh']) {
                sh '''
                    EC2_IP="''' + env.EC2_PUBLIC_IP + '''"
                    echo "🚀 Deploying to $EC2_IP..."

                    # Create app dir with sudo on EC2
                    ssh -o StrictHostKeyChecking=no ubuntu@$EC2_IP \
                        "sudo mkdir -p /opt/myapp && sudo chown ubuntu:ubuntu /opt/myapp"

                    # Copy compose file and .env to EC2
                    scp -o StrictHostKeyChecking=no \
                        app/docker-compose.yml \
                        ubuntu@$EC2_IP:/opt/myapp/docker-compose.yml

                    scp -o StrictHostKeyChecking=no \
                        app/.env \
                        ubuntu@$EC2_IP:/opt/myapp/.env

                    # Deploy on EC2 — pass credentials as env vars safely
                    ssh -o StrictHostKeyChecking=no ubuntu@$EC2_IP \
                        "DOCKER_USER=$DOCKER_USER DOCKER_PASS=$DOCKER_PASS bash -s" << 'REMOTE'
                            set -euo pipefail
                            cd /opt/myapp

                            echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin

                            docker compose pull
                            docker compose up -d --remove-orphans
                            docker image prune -f

                            echo "=== Running containers ==="
                            docker compose ps
REMOTE

                    echo "✅ Deployment complete"
                '''
            }
        }
    }
}

stage('Health Check') {
    steps {
        sh '''
            echo "🔍 Running health check..."
            for i in $(seq 1 12); do
                if curl -sf --max-time 5 "http://${EC2_PUBLIC_IP}"; then
                    echo "✅ App is healthy"
                    exit 0
                fi
                echo "  Attempt $i/12 — sleeping 10s..."
                sleep 10
            done
            echo "❌ Health check failed after 2 minutes"
            exit 1
        '''
    }
}
    }

    // ──────────────────────────────────────────────────────────
    post {
    always {
        script {
            if (env.EC2_PUBLIC_IP) {
                sshagent(credentials: ['app-server-ssh']) {
                    sh """
                        echo "=== Docker containers on EC2 ==="
                        ssh -o StrictHostKeyChecking=no \
                            ${SSH_USER}@${env.EC2_PUBLIC_IP} \
                            'docker compose ps 2>/dev/null || echo no containers running' || true
                    """
                }
            }
        }
        // Clean up generated .env files — never leave secrets on disk
        sh 'rm -f app/.env /tmp/app.env || true'
    }

    success {
        withAWS(credentials: 'aws_id', region: "${AWS_REGION}") {
            sh """
                TOPIC=\$(aws sns list-topics \
                    --region ${AWS_REGION} \
                    --query "Topics[?contains(TopicArn,'${PROJECT_NAME}-alerts')].TopicArn" \
                    --output text)

                if [ -z "\$TOPIC" ]; then
                    echo "⚠️ SNS topic not found — skipping notification"
                    exit 0
                fi

                aws sns publish \
                    --region ${AWS_REGION} \
                    --topic-arn "\$TOPIC" \
                    --subject "✅ Deploy success: ${env.JOB_NAME} #${env.BUILD_NUMBER}" \
                    --message "Build ${env.BUILD_URL} deployed successfully to ${env.EC2_PUBLIC_IP}"
            """
        }
    }

    failure {
        withAWS(credentials: 'aws_id', region: "${AWS_REGION}") {
            sh """
                TOPIC=\$(aws sns list-topics \
                    --region ${AWS_REGION} \
                    --query "Topics[?contains(TopicArn,'${PROJECT_NAME}-alerts')].TopicArn" \
                    --output text)

                if [ -z "\$TOPIC" ]; then
                    echo "⚠️ SNS topic not found — skipping notification"
                    exit 0
                fi

                aws sns publish \
                    --region ${AWS_REGION} \
                    --topic-arn "\$TOPIC" \
                    --subject "❌ Deploy failed: ${env.JOB_NAME} #${env.BUILD_NUMBER}" \
                    --message "See ${env.BUILD_URL}"
            """
        }
    }
}
}